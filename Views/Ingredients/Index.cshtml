@model IEnumerable<restaurant3.Models.Ingredient>

@{
    ViewData["Title"] = "Liste des Ingrédients";
}

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f8f9fa;
        color: #212529;
    }

    h1 {
        color: #007bff;
        text-align: center;
        margin-top: 20px;
        margin-bottom: 30px;
        font-weight: 600;
    }

    .btn {
        border-radius: 20px;
        padding: 10px 20px;
    }

    .btn-success {
        background-color: #28a745;
        color: #fff;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
    }

    .btn-info {
        background-color: #17a2b8;
        color: #fff;
    }

    .btn-danger {
        background-color: #dc3545;
        color: #fff;
    }

    .table {
        background-color: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

        .table th {
            background-color: #007bff;
            color: #fff;
            text-align: center;
        }

        .table td {
            text-align: center;
        }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f2f2f2;
    }

    .table-striped tbody tr:hover {
        background-color: #e9ecef;
        transition: background-color 0.3s ease;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }
</style>

<h1>Liste des Ingrédients</h1>

<p class="text-end">
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Ajouter un Nouvel Ingrédient
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.NomIngredient)</th>
            <th>@Html.DisplayNameFor(model => model.QuantiteStock)</th>
            <th>@Html.DisplayNameFor(model => model.Unite)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NomIngredient)</td>
                <td>@Html.DisplayFor(modelItem => item.QuantiteStock)</td>
                <td>@Html.DisplayFor(modelItem => item.Unite)</td>
                <td>
                    <div class="actions">
                        <a asp-action="Edit" asp-route-id="@item.IdIngredient" class="btn btn-primary btn-sm">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                        <a asp-action="Details" asp-route-id="@item.IdIngredient" class="btn btn-info btn-sm">
                            <i class="bi bi-info-circle"></i> Détails
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.IdIngredient" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Supprimer
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
