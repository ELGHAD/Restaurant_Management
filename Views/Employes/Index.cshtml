@model IEnumerable<restaurant3.Models.Employe>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Poste)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Salaire)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateEmbauche)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Horaires)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdEmployeNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Poste)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Salaire)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateEmbauche)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Horaires)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdEmployeNavigation.IdUtilisateur)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdEmploye">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdEmploye">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdEmploye">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
